DATABASE_URL="postgresql://postgres:dev@localhost:5433/obsalert"
AUTH_SECRET="generate with: openssl rand -base64 32"
PUBLIC_URL="http://localhost:3000"

# AUTH_TRUST_HOST / AUTH_URL are deliberately NOT required: src/auth.ts sets
# `trustHost: true`, which is correct for this self-hosted app behind a trusted
# reverse proxy. Without it, Auth.js would reject every /api/auth/* request as
# UntrustedHost whenever NODE_ENV=production (as it is in the Docker image).
