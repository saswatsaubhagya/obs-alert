DATABASE_URL="postgresql://postgres:dev@localhost:5433/obsalert"
AUTH_SECRET="generate with: openssl rand -base64 32"
PUBLIC_URL="http://localhost:3000"

# The test suite truncates every table, so it never runs against DATABASE_URL.
# It uses TEST_DATABASE_URL, defaulting to DATABASE_URL with "_test" appended to
# the database name, and refuses to run if the two are equal. Create it once:
#   docker compose exec -T db psql -U postgres -c 'CREATE DATABASE obsalert_test'
#   npm run db:test:deploy
TEST_DATABASE_URL="postgresql://postgres:dev@localhost:5433/obsalert_test"

# AUTH_TRUST_HOST / AUTH_URL are deliberately NOT required: src/auth.ts sets
# `trustHost: true`, which is correct for this self-hosted app behind a trusted
# reverse proxy. Without it, Auth.js would reject every /api/auth/* request as
# UntrustedHost whenever NODE_ENV=production (as it is in the Docker image).
