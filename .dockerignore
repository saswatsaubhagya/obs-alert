# Secrets: never bake these into an image layer.
.env*
!.env.example

# VCS history — large, and no reason to ship it in an image.
.git

# Rebuilt inside the image; a host-platform node_modules copied in would be
# wrong anyway (native addons like @node-rs/argon2 are platform-specific).
node_modules

# Build output — regenerated by `npm run build` inside the image.
.next

# Planning/task docs, not part of the running app.
.claude
.entire
docs/superpowers

# Misc noise, mirroring .gitignore.
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage
